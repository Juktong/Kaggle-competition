ds[f\\\"catboost-{i+1}\\\"] = trainer.predict(X_test)\\n    overall_scores[f\\\"catboost-{i+1}\\\"] = trainer.overall_score\\n    fold_scores[f\\\"catboost-{i+1}\\\"] = trainer.fold_scores\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:24.166651Z\",\"iopub.status.busy\":\"2026-07-01T09:41:24.16617Z\",\"iopub.status.idle\":\"2026-07-01T09:41:29.698886Z\",\"shell.execute_reply\":\"2026-07-01T09:41:29.69798Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":5.547295,\"end_time\":\"2026-07-01T09:41:29.700791+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:24.153496+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"oof_preds = pd.DataFrame(oof_preds)\\ntest_preds = pd.DataFrame(test_preds)\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:29.727013Z\",\"iopub.status.busy\":\"2026-07-01T09:41:29.726373Z\",\"iopub.status.idle\":\"2026-07-01T09:41:29.783166Z\",\"shell.execute_reply\":\"2026-07-01T09:41:29.782608Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":0.071148,\"end_time\":\"2026-07-01T09:41:29.784683+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:29.713535+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"ridge_trainer = Trainer(\\n    Ridge(**ridge_params),\\n    task=\\\"regression\\\",\\n    metric=CFG.metric,\\n    cv=CFG.cv,\\n    cv_args={\\\"groups\\\": g},\\n    verbose=True\\n)\\n\\nridge_trainer.fit(oof_preds, y)\\n\\nridge_oof_preds = ridge_trainer.oof_preds\\nridge_test_preds = ridge_trainer.predict(test_preds)\\n\\noverall_scores[\\\"ridge\\\"] = ridge_trainer.overall_score\\nfold_scores[\\\"ridge\\\"] = ridge_trainer.fold_scores\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:29.809836Z\",\"iopub.status.busy\":\"2026-07-01T09:41:29.809258Z\",\"iopub.status.idle\":\"2026-07-01T09:41:36.069826Z\",\"shell.execute_reply\":\"2026-07-01T09:41:36.069011Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":6.274454,\"end_time\":\"2026-07-01T09:41:36.07135+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:29.796896+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"def apply_pp(df, md, pd_, alpha, tau, w_pf):\\n    d = md * (1-w_pf) + pd_ * w_pf\\n    if tau: \\n        d *= (1.-np.exp(-np.maximum(df['md_since'].values,0.) / tau))\\n        \\n    return d * alpha\\n\\ndef sg_smooth(df, col, sg_w=17, sg_p=3):\\n    df = df.copy()\\n    \\n    for _, g in df.groupby('well', sort=False):\\n        v = g[col].values\\n        n = len(v)\\n        wl = min(sg_w, n)\\n        \\n        if wl % 2 == 0: \\n            wl -= 1\\n            \\n        if wl >= sg_p + 2: \\n            v = savgol_filter(v, wl, sg_p)\\n            \\n        df.loc[g.index,col] = v\\n        \\n    return df\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:36.097541Z\",\"iopub.status.busy\":\"2026-07-01T09:41:36.09717Z\",\"iopub.status.idle\":\"2026-07-01T09:41:36.102768Z\",\"shell.execute_reply\":\"2026-07-01T09:41:36.102122Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":0.020099,\"end_time\":\"2026-07-01T09:41:36.10403+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:36.083931+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"base = train_df['last_known_tvt'].values\\nytrue = y.values + base\\n\\npf_oof = (train_df['pf_ancc'].values - base)\\n\\nd = apply_pp(train_df, ridge_oof_preds, pf_oof, **pp_params)\\nridge_score = root_mean_squared_error(ytrue, base + d)\\n\\noverall_scores[\\\"ridge (pp)\\\"] = ridge_score\\nfold_scores[\\\"ridge (pp)\\\"] = [ridge_score] * CFG.n_splits\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:36.130009Z\",\"iopub.status.busy\":\"2026-07-01T09:41:36.129628Z\",\"iopub.status.idle\":\"2026-07-01T09:41:36.215916Z\",\"shell.execute_reply\":\"2026-07-01T09:41:36.215063Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":0.101913,\"end_time\":\"2026-07-01T09:41:36.217711+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:36.115798+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"test_df2 = test_df.copy()\\npf_test = test_df2['pf_ancc'].values - test_df2['last_known_tvt'].values\\n\\ntest_df2['pred'] = test_df2['last_known_tvt'].values + apply_pp(\\n    test_df2, \\n    ridge_test_preds,\\n    pf_test, \\n    **pp_params\\n)\\ntest_df2 = sg_smooth(test_df2, 'pred')\\n\",\"metadata\":{\"_kg_hide-input\":true,\"execution\":{\"iopub.execute_input\":\"2026-07-01T09:41:36.243462Z\",\"iopub.status.busy\":\"2026-07-01T09:41:36.242862Z\",\"iopub.status.idle\":\"2026-07-01T09:41:36.271976Z\",\"shell.execute_reply\":\"2026-07-01T09:41:36.271444Z\"},\"jupyter\":{\"source_hidden\":true},\"papermill\":{\"duration\":0.043171,\"end_time\":\"2026-07-01T09:41:36.273312+00:00\",\"exception\":false,\"start_time\":\"2026-07-01T09:41:36.230141+00:00\",\"status\":\"completed\"},\"source_hidden\":true,\"tags\":[]},\"outputs\":[],\"execution_count\":null},{\"cell_type\":\"code\",\"source\":\"sample_sub = pd.read_csv(CFG.dataset_path / \\\"sample_submission.csv\\\")\\nsub_1 = (sample_sub[['id']].merge(\\n    test_df2[['id', 'pred']].rename(columns={'pred':'tvt'}),\\n    on='id', \\n    how='left'\\n))\\n\\nsub_1['tvt']=sub_1['tvt'].fillna(float(train_df['last_known_tvt'].mean()+train_df['target'].mean()))\\nsub